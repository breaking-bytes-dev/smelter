<?xml version="1.0" encoding="utf-8"?>
<!--
  Botones de command bar del form de Import Job. Hay UN SOLO camino de ejecución, el Cloud Flow:
  los botones solo ponen el job en Queued (Sanic.Smelter.executeImportJob/retryImportJob,
  Assets/sanic_smlt_importjob_actions.js) y el flow (trigger status eq 0) corre Prepare + ProcessChunk.

  Enable rules (siempre visibles, se habilitan según el estado):
    - Ejecutar:   status vacío (job que nunca corrió; la columna no tiene default).
    - Reintentar: status Completed (2) / CompletedWithErrors (3) / Failed (4).
    - Ambos deshabilitados en Queued/Processing y en registros nuevos sin guardar (FormStateRule Create).
  ValueRule no puede expresar "vacío" ni "uno de varios valores" (las reglas se combinan con AND),
  por eso el estado se evalúa con CustomRule JS (canExecuteImportJob/canRetryImportJob).

  Ubicación: Mscrm.Form.<entidad>.MainTab.Actions.Controls._children es el patrón estándar para
  agregar botones al command bar del form principal. Confirmado por convención, NO contra un Dev
  real (ver gotcha de Fase 1 en SolutionZipBuilder.cs).
-->
<RibbonDiffXml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <CustomActions>
    <CustomAction Id="sanic.smlt.EjecutarImportJob.Button.CustomAction" Location="Mscrm.Form.sanic_tbl_smlt_importjob.MainTab.Actions.Controls._children" Sequence="50">
      <CommandUIDefinition>
        <Button Command="sanic.smlt.EjecutarImportJob.Command" Id="sanic.smlt.EjecutarImportJob.Button" LabelText="$LocLabels:sanic.smlt.EjecutarImportJob.Button.LabelText" Sequence="50" TemplateAlias="o1" ToolTipTitle="$LocLabels:sanic.smlt.EjecutarImportJob.Button.ToolTipTitle" ToolTipDescription="$LocLabels:sanic.smlt.EjecutarImportJob.Button.ToolTipDescription" />
      </CommandUIDefinition>
    </CustomAction>
    <CustomAction Id="sanic.smlt.ReintentarImportJob.Button.CustomAction" Location="Mscrm.Form.sanic_tbl_smlt_importjob.MainTab.Actions.Controls._children" Sequence="55">
      <CommandUIDefinition>
        <Button Command="sanic.smlt.ReintentarImportJob.Command" Id="sanic.smlt.ReintentarImportJob.Button" LabelText="$LocLabels:sanic.smlt.ReintentarImportJob.Button.LabelText" Sequence="55" TemplateAlias="o2" ToolTipTitle="$LocLabels:sanic.smlt.ReintentarImportJob.Button.ToolTipTitle" ToolTipDescription="$LocLabels:sanic.smlt.ReintentarImportJob.Button.ToolTipDescription" />
      </CommandUIDefinition>
    </CustomAction>
  </CustomActions>
  <Templates>
    <RibbonTemplates Id="Mscrm.Templates"></RibbonTemplates>
  </Templates>
  <CommandDefinitions>
    <CommandDefinition Id="sanic.smlt.EjecutarImportJob.Command">
      <EnableRules>
        <EnableRule Id="sanic.sanic_tbl_smlt_importjob.FormStateEnableRule.EnableRule" />
        <EnableRule Id="sanic.smlt.EjecutarImportJob.EnableRule" />
      </EnableRules>
      <Actions>
        <JavaScriptFunction FunctionName="Sanic.Smelter.executeImportJob" Library="$webresource:sanic_smlt_importjob_actions.js">
          <CrmParameter Value="PrimaryControl" />
        </JavaScriptFunction>
      </Actions>
    </CommandDefinition>
    <CommandDefinition Id="sanic.smlt.ReintentarImportJob.Command">
      <EnableRules>
        <EnableRule Id="sanic.sanic_tbl_smlt_importjob.FormStateEnableRule.EnableRule" />
        <EnableRule Id="sanic.smlt.ReintentarImportJob.EnableRule" />
      </EnableRules>
      <Actions>
        <JavaScriptFunction FunctionName="Sanic.Smelter.retryImportJob" Library="$webresource:sanic_smlt_importjob_actions.js">
          <CrmParameter Value="PrimaryControl" />
        </JavaScriptFunction>
      </Actions>
    </CommandDefinition>
  </CommandDefinitions>
  <RuleDefinitions>
    <TabDisplayRules />
    <DisplayRules />
    <EnableRules>
      <EnableRule Id="sanic.sanic_tbl_smlt_importjob.FormStateEnableRule.EnableRule">
        <FormStateRule State="Create" InvertResult="true" />
      </EnableRule>
      <EnableRule Id="sanic.smlt.EjecutarImportJob.EnableRule">
        <CustomRule FunctionName="Sanic.Smelter.canExecuteImportJob" Library="$webresource:sanic_smlt_importjob_actions.js" Default="false">
          <CrmParameter Value="PrimaryControl" />
        </CustomRule>
      </EnableRule>
      <EnableRule Id="sanic.smlt.ReintentarImportJob.EnableRule">
        <CustomRule FunctionName="Sanic.Smelter.canRetryImportJob" Library="$webresource:sanic_smlt_importjob_actions.js" Default="false">
          <CrmParameter Value="PrimaryControl" />
        </CustomRule>
      </EnableRule>
    </EnableRules>
  </RuleDefinitions>
  <LocLabels>
    <LocLabel Id="sanic.smlt.EjecutarImportJob.Button.LabelText">
      <Titles>
        <Title description="Ejecutar" languagecode="1033" />
      </Titles>
    </LocLabel>
    <LocLabel Id="sanic.smlt.EjecutarImportJob.Button.ToolTipTitle">
      <Titles>
        <Title description="Ejecutar" languagecode="1033" />
      </Titles>
    </LocLabel>
    <LocLabel Id="sanic.smlt.EjecutarImportJob.Button.ToolTipDescription">
      <Titles>
        <Title description="Pone el job en cola: el procesamiento corre en el servidor (Cloud Flow)." languagecode="1033" />
      </Titles>
    </LocLabel>
    <LocLabel Id="sanic.smlt.ReintentarImportJob.Button.LabelText">
      <Titles>
        <Title description="Reintentar" languagecode="1033" />
      </Titles>
    </LocLabel>
    <LocLabel Id="sanic.smlt.ReintentarImportJob.Button.ToolTipTitle">
      <Titles>
        <Title description="Reintentar" languagecode="1033" />
      </Titles>
    </LocLabel>
    <LocLabel Id="sanic.smlt.ReintentarImportJob.Button.ToolTipDescription">
      <Titles>
        <Title description="Vuelve a encolar un job terminado (Completed, CompletedWithErrors o Failed); se re-procesa desde cero." languagecode="1033" />
      </Titles>
    </LocLabel>
  </LocLabels>
</RibbonDiffXml>
