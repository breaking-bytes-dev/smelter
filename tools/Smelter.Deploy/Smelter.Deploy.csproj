<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Corre sobre un runtime mayor si el 8.0 no está instalado (máquinas con solo .NET 9/10). -->
    <RollForward>LatestMajor</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Smelter.Deploy</RootNamespace>
    <!-- Herramienta de despliegue: no es artefacto de producción, no se empaqueta. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.PowerPlatform.Dataverse.Client" Version="1.2.26" />
  </ItemGroup>

  <ItemGroup>
    <!-- Assets versionados de UX (RibbonDiffXml + JS de los botones Ejecutar/Reintentar, Fase 4)
         embebidos en el assembly: SecurityProvisioner los lee vía GetManifestResourceStream, sin
         depender del working directory del proceso que corre el deploy (CI vs local). -->
    <EmbeddedResource Include="Assets\*" />
    <!-- Íconos SVG de la MDA/tablas (IconsSpec.cs): se leen con AssetLoader.ReadText("icons.<archivo>"). -->
    <EmbeddedResource Include="Assets\icons\*.svg" />
  </ItemGroup>

  <ItemGroup>
    <!-- Core (netstandard2.0, puro): E2eSpec arma los TemplateExportDto de los pasos [E2E-n] de Smelter.Verify con el MISMO
         DTO del producto, y los tests de contrato los validan con TemplateSerializer/TemplateValidator/TransformEngine. -->
    <ProjectReference Include="..\..\src\Smelter.Core\Smelter.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Los tests de contrato corroboran la ApiSpec contra la metadata de solutions/unpacked/;
         Smelter.Verify usa los uniquenames de la ApiSpec como fuente única. -->
    <InternalsVisibleTo Include="Smelter.Contract.Tests" />
    <InternalsVisibleTo Include="Smelter.Verify" />
  </ItemGroup>

</Project>
