<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <RootNamespace>Smelter.Plugins</RootNamespace>
    <AssemblyName>Smelter.Plugins</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <Description>Smelter — CSV/Excel to Dataverse normalizer plugin package</Description>
    <Company>SANIC</Company>
    <Product>Smelter</Product>
    <PackageId>Smelter.Plugins</PackageId>
    <Version>1.0.8</Version>
    <Authors>SANIC</Authors>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CrmSdk.CoreAssemblies" Version="9.0.2.56" PrivateAssets="All" />
    <PackageReference Include="Microsoft.PowerApps.MSBuild.Plugin" Version="1.*" PrivateAssets="All" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.*" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <!-- Núcleo puro (netstandard2.0): parser CSV, transform DSL, DAG, serialización de templates.
         CsvHelper llega transitivamente desde el Core. -->
    <ProjectReference Include="..\Smelter.Core\Smelter.Core.csproj" />
  </ItemGroup>

</Project>
